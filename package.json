{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:trash": "node --experimental-test-module-mocks --import tsx --test tests/trashRestore.test.ts",
    "test:firestore": "firebase emulators:exec --config firebase.emulators.json --project demo-my-root-cuba --only firestore \"tsx --test tests/firestore.rules.test.ts\"",
    "test:sync": "tsx --test tests/cloudSync.test.ts",
    "test:storage": "tsx --test tests/localStorage.test.ts tests/persistentBackup.test.ts tests/projectArchive.test.ts tests/cloudRestore.test.ts tests/cloudRead.test.ts tests/cloudTrash.test.ts tests/familyRestore.test.ts",
    "test:api": "tsx --test tests/api.test.ts tests/aiClient.test.ts",
    "test:server": "tsx --test tests/server.test.ts",
    "test": "npm run test:sync && npm run test:storage && npm run test:search && npm run test:tree && npm run test:duplicates && npm run test:merge && npm run test:delta && npm run test:deploy && npm run test:api",
    "test:duplicates": "tsx --test tests/ignoredDuplicates.test.ts",
    "test:duplicates-browser": "node scripts/check-ignored-duplicates-browser.mjs",
    "test:search": "tsx --test tests/searchRegression.test.ts",
    "bench:tree-sync": "node --expose-gc --import tsx scripts/benchmark-cloud-batch.ts",
    "test:tree": "tsx --test tests/treeLayout.test.ts tests/treePersonCard.test.ts tests/treeViewport.test.ts tests/treeViewState.test.ts",
    "test:tree-browser": "node scripts/check-tree-cards-browser.mjs",
    "test:tree-view-browser": "node scripts/check-tree-view-browser.mjs",
    "test:merge": "node --experimental-test-module-mocks --import tsx --test tests/personMergeRecovery.test.ts tests/mergedPersonState.test.ts",
    "test:delta": "node --import tsx --test tests/personDelta.test.ts",
    "bench:delta": "node --import tsx benchmarks/personDelta.ts",
    "test:merge-browser": "node scripts/check-safe-merge-browser.mjs",
    "bench:tree": "node --import tsx benchmarks/treeLayoutCache.ts",
    "test:deploy": "node --import tsx --test tests/deployment.test.ts tests/aiAccess.test.ts",
    "prepare:hosting": "node scripts/hosting-config.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.22.1",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "6.2.8",
    "firebase-tools": "14.27.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
